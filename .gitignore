# ==========================================
# CargoLens .gitignore
# ==========================================

# Environment variables & secrets (CRITICAL: Never commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
backend/.env
frontend/.env.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python Virtual Environments
.venv/
venv/
ENV/
env/
backend/.venv/
backend/venv/

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
.ruff_cache/

# Databases & local persistent state
*.db
*.sqlite
*.sqlite3
cargolens.db
backend/cargolens.db
postgres_data/

# Uploaded documents & local file storage
storage/
backend/storage/
uploads/

# Node & Next.js (Frontend)
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
build/
dist/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Submission zips and generated docs
*.zip
!sample_data/*.zip
cargolens_submission.zip
